---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import Vinyl from '../../components/album/Vinyl.astro';
import { Image } from 'astro:assets';
import studioAligning from '../../assets/photos/2026-album-studio/aligning-in-studio.jpg';
import studioDrums from '../../assets/photos/2026-album-studio/drums-room.jpg';
import studioKeys from '../../assets/photos/2026-album-studio/studio-keys-portrait.jpg';
import { formatDate } from '../../lib/format';
import { getLang, localize, pick, useT } from '../../i18n';
import { localizeAll } from '../../i18n/content';
import { pieceImage } from './photos.de';

const lang = getLang(Astro);
const de = lang === 'de';
const t = useT(lang);
const studio = [
  { src: studioAligning, alt: { en: 'Benjamin Orthner aligning the optics of the experiment in the recording studio.', de: 'Benjamin Orthner justiert im Aufnahmestudio die Optik des Experiments.' } },
  { src: studioDrums, alt: { en: 'The drummer in the live room of the studio.', de: 'Die Schlagzeugerin im Aufnahmeraum des Studios.' } },
  { src: studioKeys, alt: { en: 'The keyboard player recording, surrounded by keyboards.', de: 'Der Keyboarder bei der Aufnahme, umgeben von Keyboards.' } },
];

const pieces = await localizeAll('pieces', (await getCollection('pieces')).sort((a, b) => a.data.order - b.data.order), lang);
const repertoire = pieces.filter((p) => p.data.status === 'repertoire');
const experimental = pieces.filter((p) => p.data.status === 'experimental');
const shows = await localizeAll('shows', await getCollection('shows', (s) => !s.data.draft && s.data.kind === 'performance'), lang);
const premiereOf = (id: string) =>
  shows.filter((s) => s.data.piece?.id === id && s.data.premiere).sort((a, b) => +a.data.date - +b.data.date)[0];
---
<Base
  title={t('nav.pieces')}
  description={de
    ? 'Drei Stücke für verschränkte Photonen und Live-Musik: BruQner, 8 Rooms und Indeterminate Apparatus.'
    : 'Three pieces for entangled photons and live musicians: BruQner, 8 Rooms and Indeterminate Apparatus.'}
>
  <header class="wrap intro">
    <h1>{t('nav.pieces')}</h1>
    {de ? (
      <p class="lede">
        Jedes Stück bekommt dieselbe Art von Daten: mehrmals pro Sekunde ein Ergebnis für Alice und eines für Bob.
        Von Stück zu Stück ändert sich nur, worüber diese Ergebnisse entscheiden dürfen.
      </p>
    ) : (
      <p class="lede">
        Every piece receives the same kind of data: a few times a second, one result for Alice and one for Bob.
        What changes from piece to piece is what those results are allowed to decide.
      </p>
    )}
    <div class="idea">
      {de ? (
        <p>
          Bei jeder Messung erhält Alice eines von vier möglichen Ergebnissen, Bob ebenso: sechzehn Kombinationen
          insgesamt. Alles, was in diesen Stücken aus den Messungen Musik macht, beruht auf einer einzigen Tatsache.
        </p>
      ) : (
        <p>
          Each measurement gives Alice one of four outcomes and Bob one of four: sixteen possible combinations.
          Every mapping in these pieces is built on one fact about them.
        </p>
      )}
      <blockquote>
        <p>{de ? '„Verschränkung verstärkt manche Kombinationen und unterdrückt andere.“' : '“Entanglement enhances some combinations and suppresses others.”'}</p>
        <footer class="ui dim">Clemens Wenger</footer>
      </blockquote>
    </div>
  </header>

  <div class="list">
    {repertoire.map((p, i) => {
      const premiere = premiereOf(p.id);
      return (
        <section class:list={['piece', i % 2 ? 'flip' : '']} aria-labelledby={`p-${p.id}`}>
          <div class="wrap grid">
            {p.data.cover && (
              <a class="image" href={localize(lang, `/pieces/${p.id}/`)} tabindex="-1" aria-hidden="true">
                <Photo {...pieceImage(lang, p.data.cover)} sizes="(min-width: 1000px) 62vw, 100vw" ratio="3 / 2" />
              </a>
            )}
            <div class="text">
              <p class="year ui num">{p.data.year}</p>
              <h2 id={`p-${p.id}`}><a href={localize(lang, `/pieces/${p.id}/`)}>{p.data.title}</a></h2>
              <p class="forces">{p.data.forces}</p>
              <p class="summary">{p.data.summary}</p>
              <p class="mapping dim">{p.data.mapping}</p>
              <p class="meta ui dim">
                {premiere && <>{de ? 'Uraufführung am' : 'Premiered'} {formatDate(premiere.data.date, lang)}, {premiere.data.venue.replace(/ \(.*\)$/, '')}, {premiere.data.city}.</>}
              </p>
              <p class="more ui"><a href={localize(lang, `/pieces/${p.id}/`)}>{de ? 'Mehr zu' : 'About'} {p.data.title}</a></p>
            </div>
          </div>
        </section>
      );
    })}
  </div>

  <section class="wrap grid statement" aria-labelledby="statement">
    <h2 id="statement">{de ? 'Warum für ein Experiment komponieren' : 'Why compose for an experiment'}</h2>
    {de ? (
    <div class="statement-text">
      <p>
        Wir spielen mit der Natur, nicht mit Datensammlungen. Gemessen wird in Echtzeit, und die Musiker:innen
        antworten live darauf, auf der Bühne, das Experiment direkt vor sich.
      </p>
      <p>
        Der Zufall ist objektiv. Er hat keine Launen und kein Lieblingsmaterial, und genau deshalb bleiben die
        musikalische Form und der Klang wirklich offen.
      </p>
      <p>
        Dazu bringt die Verschränkung etwas mit, das kein Würfel kann: Zufall und Ordnung zugleich. Was das ist
        und was Musik damit anfangen kann, ist Neuland für die Musiktheorie. Es verlangt nach einem neuen
        Instrument, nach neuen Kompositionen und am Ende nach einer neuen Ästhetik.
      </p>
      <p class="ui dim byline">Clemens Wenger, Komponist. Nach seinen Notizen für den Vortrag zur Uraufführung.</p>
    </div>
    ) : (
    <div class="statement-text">
      <p>
        We play with nature, not with data collections. The measurements happen in real time, and the
        musicians answer them live, on stage, with the experiment in front of them.
      </p>
      <p>
        The chance is objective. It has no moods and no favourite material, which leaves the musical form
        and the sound genuinely open.
      </p>
      <p>
        And entanglement brings something no dice can: chance and order at once. What that is, and what
        music can do with it, is new ground for music theory. It asks for a new instrument, new
        compositions and, in the end, a new aesthetic.
      </p>
      <p class="ui dim byline">Clemens Wenger, composer. Adapted from his notes for the premiere lecture.</p>
    </div>
    )}
  </section>

  <section class="wrap grid experiments" aria-labelledby="experiments">
    <div class="exp-head">
      <h2 id="experiments">{de ? 'Studien' : 'Studies'}</h2>
      <p class="dim">
        {de
          ? 'Zwei Experimentalstücke, entstanden 2024 bei den Probeterminen in Wien, während der Aufbau für die Uraufführung vorbereitet wurde.'
          : 'Two experimental pieces from the rehearsal events in Vienna in 2024, while the setup was being prepared for the premiere.'}
      </p>
    </div>
    <ul class="exp-list">
      {experimental.map((p) => (
        <li>
          <h3><a href={localize(lang, `/pieces/${p.id}/`)}>{p.data.title}</a></h3>
          <p class="dim">{p.data.summary}</p>
          {p.data.audio[0] && <AudioPlayer src={p.data.audio[0].src} title={p.data.audio[0].title} note={p.data.audio[0].note} />}
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap grid album" aria-labelledby="album">
    <a class="album-record" href={localize(lang, '/album/')} aria-label={de ? 'Sounds of Entanglement, das Album' : 'Sounds of Entanglement, the album'}><Vinyl size="small" /></a>
    <div class="album-text">
      <h2 id="album"><a href={localize(lang, '/album/')}><em>Sounds of Entanglement</em></a></h2>
      <p class="status">{de ? 'Aufgenommen, aber noch nicht erschienen. Auf Vinyl und digital.' : 'Recorded. Not released yet. Vinyl and digital.'}</p>
      {de ? (
        <p class="about">
          Das erste Album von The Uncertain Question (Clemens Wenger, Manu Mayr, Judith Schwarz): Musik, dirigiert
          von verschränkten Photonenpaaren, live im Studio aufgenommen, mit dem Experiment mitten im Raum.
        </p>
      ) : (
        <p class="about">
          The first album of The Uncertain Question (Clemens Wenger, Manu Mayr, Judith Schwarz): music conducted
          by pairs of entangled photons, recorded live with the experiment in the studio.
        </p>
      )}
      <a class="studio-strip" href={localize(lang, '/album/')} aria-label={de ? 'Fotos von den Aufnahmen, auf der Albumseite' : 'Photographs from the recording, on the album page'}>
        {studio.map((i) => <Image src={i.src} alt={pick(lang, i.alt)} widths={[320, 480, 640]} sizes="(min-width: 1000px) 16vw, 30vw" format="webp" />)}
      </a>
      <p class="strip-foot ui">
        <a href={localize(lang, '/album/')}>{de ? 'Mehr zum Album' : 'About the album'}</a>
        <span class="dim">{de ? 'Fotos von den Aufnahmen: Benjamin Orthner' : 'Photos from the recording: Benjamin Orthner'}</span>
      </p>
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(4rem, 9vw, 8rem) clamp(3rem, 6vw, 5rem); }
  .intro h1 { font-size: var(--step-5); }
  .lede {
    margin-top: 1.75rem;
    font-size: var(--step-1);
    font-weight: 300;
    line-height: 1.45;
    max-width: 44ch;
  }

  .idea {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: 1rem var(--gutter);
    align-items: end;
    max-width: 1100px;
  }
  .idea > p { font-size: 1rem; color: var(--ash); margin: 0; }
  blockquote { margin: 0; }
  blockquote p {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: var(--step-3);
    line-height: 1.15;
    margin: 0;
    max-width: 22ch;
  }
  blockquote footer { margin-top: 0.75rem; }

  .statement {
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--graphite);
    row-gap: 2rem;
  }
  .statement h2 { grid-column: 1 / span 4; font-size: var(--step-3); }
  .statement-text { grid-column: 6 / span 7; }
  .statement-text p:not(.byline) { font-size: var(--step-1); font-weight: 300; line-height: 1.45; }
  .byline { margin-top: 1.5rem; }

  .piece { padding-block: clamp(3rem, 7vw, 6rem); border-top: 1px solid var(--graphite); }
  .piece .grid { align-items: center; row-gap: 2rem; }
  .image { grid-column: 1 / span 7; display: block; text-decoration: none; }
  .text { grid-column: 9 / span 4; }
  .flip .image { grid-column: 6 / span 7; grid-row: 1; }
  .flip .text { grid-column: 1 / span 4; grid-row: 1; }
  .year { color: var(--ash); margin: 0 0 0.5rem; }
  h2 { font-size: var(--step-4); }
  h2 a { text-decoration: none; }
  h2 a:hover { text-decoration: underline; text-decoration-thickness: 1px; }
  .forces { margin: 0.9rem 0 1.4rem; font-style: italic; color: var(--ash); line-height: 1.4; }
  .summary { font-size: var(--step-0); }
  .mapping { font-size: 1rem; }
  .meta { margin-top: 1.25rem; font-size: 0.875rem; }
  .more { margin-top: 1.25rem; }
  .more a { text-decoration-color: var(--smoke); }

  .experiments {
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: 1px solid var(--graphite);
    row-gap: 2rem;
  }
  .exp-head { grid-column: 1 / span 4; }
  .exp-head h2 { font-size: var(--step-3); margin-bottom: 1rem; }
  .exp-head p { font-size: 1rem; }
  .exp-list { grid-column: 6 / span 7; list-style: none; margin: 0; padding: 0; }
  .exp-list li { padding-bottom: 2.5rem; }
  .exp-list h3 { font-size: var(--step-2); margin-bottom: 0.5rem; }
  .exp-list h3 a { text-decoration: none; }
  .exp-list p { font-size: 1rem; }

  .album {
    padding-block: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--graphite);
    align-items: center;
    row-gap: 2rem;
  }
  .album-record {
    grid-column: 1 / span 5;
    justify-self: end;
    display: block;
    width: min(100%, 360px);
    aspect-ratio: 1;
    border-radius: 50%;
    transition: transform 0.4s ease;
  }
  .album-record :global(.vinyl.small) { --d: 100%; }
  .album-record:hover { transform: scale(1.02); }
  .album-record:focus-visible { outline-offset: 6px; }
  .album-text { grid-column: 7 / span 6; max-width: 34rem; }
  .album h2 { font-size: var(--step-3); margin: 0; }
  .album h2 em { font-style: normal; }
  .album h2 a { text-decoration: none; }
  .album h2 a:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.15em; }
  .album .status { font-size: var(--step-1); font-weight: 300; margin: 0.75rem 0 0; }
  .album .about { margin: 0.75rem 0 0; font-size: 1rem; color: var(--ash); }
  .album .studio-strip { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; margin-top: 1.5rem; }
  .album .studio-strip :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: brightness(0.82);
    transition: filter 0.3s ease;
  }
  .album .studio-strip:hover :global(img) { filter: brightness(1); }
  .strip-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin: 0.6rem 0 0;
    font-size: 0.8125rem;
  }
  .strip-foot a { font-size: 0.9375rem; }
  @media (prefers-reduced-motion: reduce) { .album-record { transition: none; } .album-record:hover { transform: none; } }

  @media (max-width: 900px) {
    .album-record { grid-column: 1 / -1; justify-self: center; width: min(70vw, 300px); }
  }
  @media (max-width: 900px) {
    .image, .text, .flip .image, .flip .text, .exp-head, .exp-list, .album-text, .statement h2, .statement-text { grid-column: 1 / -1; grid-row: auto; }
    .idea { grid-template-columns: 1fr; }
  }
</style>
