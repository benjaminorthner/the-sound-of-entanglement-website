---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Photo from '../../components/Photo.astro';
import AudioPlayer from '../../components/AudioPlayer.astro';
import YouTube from '../../components/YouTube.astro';
import Performances from '../../components/pieces/Performances.astro';
import Rings from '../../components/visuals/rings/Rings.astro';
import Terrain from '../../components/visuals/terrain/Terrain.astro';
import Metronome from '../../components/visuals/metronome/Metronome.astro';
import BruqnerStory from '../../components/pieces/bruqner/BruqnerStory.astro';
import IAStory from '../../components/pieces/indeterminate-apparatus/IAStory.astro';
import { formatDate } from '../../lib/format';
import { getLang, localize, useT } from '../../i18n';
import { localized, localizeAll } from '../../i18n/content';
import { pieceImage } from './photos.de';


interface Props {
  piece: CollectionEntry<'pieces'>;
  prev?: CollectionEntry<'pieces'>;
  next?: CollectionEntry<'pieces'>;
}
const { piece, prev, next } = Astro.props;
const lang = getLang(Astro);
const de = lang === 'de';
const t = useT(lang);
const loc = await localized('pieces', piece, lang);
const d = loc.data;
const { Content } = await render(loc.entry);
const prevTitle = prev && (await localized('pieces', prev, lang)).data.title;
const nextTitle = next && (await localized('pieces', next, lang)).data.title;

const shows = await localizeAll('shows', (await getCollection('shows', (s) => !s.data.draft && s.data.piece?.id === piece.id))
  .sort((a, b) => +b.data.date - +a.data.date), lang);
const premiere = shows.filter((s) => s.data.premiere).sort((a, b) => +a.data.date - +b.data.date)[0];
const hasVisual = d.visual !== 'none';
// These pieces get a photographic story instead of the generic image layout.
const isStory = piece.id === 'bruqner' || piece.id === 'indeterminate-apparatus';
const cover = d.cover && pieceImage(lang, d.cover);
const [firstImage, ...moreImages] = d.images.map((img) => pieceImage(lang, img));
const and = de ? 'und' : 'and';
const composers = d.composers.join(', ').replace(/, ([^,]*)$/, ` ${and} $1`);
const listenTitle = d.youtube && d.audio.length
  ? (de ? 'Hören und sehen' : 'Listen and watch')
  : d.youtube ? (de ? 'Video' : 'Watch') : (de ? 'Hören' : 'Listen');
const durations: Record<string, string> = de ? { bruqner: '18 Min.', '8-rooms': '12 Min.' } : { bruqner: '18 min', '8-rooms': '12 min' };
// Figures drawn on white are shown inverted so they sit on the dark page.
const LIGHT_FIGURES = ['bruqner-motifs', 'quantum-random-walk'];
const isLight = (src: { src: string }) => LIGHT_FIGURES.some((f) => src.src.includes(f));
---
<Base title={d.title} description={d.summary} underHeader={hasVisual} image={cover?.src} imageAlt={cover?.alt}>
  {d.visual === 'rings' && <Rings />}
  {d.visual === 'terrain' && <Terrain />}
  {d.visual === 'metronome' && <Metronome />}

  <article class:list={['piece', { plain: !hasVisual }]}>
    <header class="wrap grid head">
      <div class="title">
        <p class="ui back"><a href={localize(lang, '/pieces/')}>{t('nav.pieces')}</a></p>
        <h1>{d.title}</h1>
        <p class="forces">{d.forces}</p>
      </div>
      <dl class="facts ui">
        <div><dt>{de ? 'Jahr' : 'Year'}</dt><dd class="num">{d.year}</dd></div>
        <div><dt>{de ? 'Musik' : 'Music'}</dt><dd>{composers}</dd></div>
        {d.visualsBy.length > 0 && <div><dt>Visuals</dt><dd>{d.visualsBy.join(` ${and} `)}</dd></div>}
        {premiere && (
          <div><dt>{de ? 'Uraufführung' : 'Premiere'}</dt><dd><a href={localize(lang, `/shows/${premiere.id}/`)}>{formatDate(premiere.data.date, lang)}, {premiere.data.city}</a></dd></div>
        )}
      </dl>
    </header>

    <div class="wrap grid body">
      <div class="lead">
        <p>{d.summary}</p>
        <p class="mapping dim">{d.mapping}</p>
      </div>
      <div class="prose">
        <Content />
      </div>
      {firstImage && (
        <aside class="side-image">
          <Photo {...firstImage} sizes="(min-width: 1000px) 34vw, 100vw" class={isLight(firstImage.src) ? 'inverted' : undefined} />
        </aside>
      )}
    </div>

    {piece.id === 'bruqner' && <BruqnerStory />}
    {piece.id === 'indeterminate-apparatus' && <IAStory />}

    {cover && !isStory && (
      <div class="cover">
        <Photo {...cover} bleed sizes="100vw" />
      </div>
    )}

    {moreImages.length > 0 && !isStory && (
      <div class="wrap grid more">
        {moreImages.map((img, i) => (
          <div class:list={['more-item', `m${i % 2}`]}>
            <Photo {...img} sizes="(min-width: 1000px) 50vw, 100vw" class={isLight(img.src) ? 'inverted' : undefined} />
          </div>
        ))}
      </div>
    )}

    {(d.audio.length > 0 || d.youtube) && (
      <section class="wrap grid listen" aria-labelledby="listen">
        <h2 id="listen" class="section-title">{listenTitle}</h2>
        {d.audio.length > 0 && (
          <div class="audio">
            {d.audio.map((a) => <AudioPlayer src={a.src} title={a.title} note={a.note} />)}
          </div>
        )}
        {d.youtube && cover && (
          <div class="video">
            <YouTube
              id={d.youtube}
              title={piece.id === 'bruqner' ? `BruQner – The Sound of Entanglement, ${de ? 'Dokumentarfilm' : 'documentary'}` : `${d.title}, live`}
              poster={cover.src}
              posterAlt={cover.alt}
              duration={durations[piece.id]}
            />
          </div>
        )}
      </section>
    )}

    {shows.length > 0 && (
      <section class="wrap perf" aria-labelledby="performances">
        <h2 id="performances" class="section-title">{shows.some((s) => s.data.kind === 'talk') ? (de ? 'Aufführungen und Vorträge' : 'Performances and talks') : (de ? 'Aufführungen' : 'Performances')}</h2>
        <p class="dim perf-note">
          {de
            ? 'Mit dem Bell-Wert, der bei der jeweiligen Aufführung gemessen wurde. Liegt er über 2, kann keine klassische Quelle die Korrelationen erzeugt haben.'
            : 'With the Bell value measured during each performance. Above 2, no classical source could have produced the correlations.'}
        </p>
        <Performances shows={shows} />
      </section>
    )}

    <nav class="wrap pager ui" aria-label={de ? 'Weitere Stücke' : 'Other pieces'}>
      {prev ? <a href={localize(lang, `/pieces/${prev.id}/`)} rel="prev"><span class="dim">{de ? 'Voriges' : 'Previous'}</span> {prevTitle}</a> : <span></span>}
      <a href={localize(lang, '/pieces/')} class="all">{de ? 'Alle Stücke' : 'All pieces'}</a>
      {next ? <a href={localize(lang, `/pieces/${next.id}/`)} rel="next" class="next"><span class="dim">{de ? 'Nächstes' : 'Next'}</span> {nextTitle}</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .piece { padding-top: clamp(3rem, 7vw, 6rem); }
  .piece.plain { padding-top: clamp(4rem, 10vw, 8rem); }

  .head { row-gap: 2.5rem; align-items: end; }
  .title { grid-column: 1 / span 8; }
  .back { margin: 0 0 1.25rem; }
  .back a { color: var(--ash); text-decoration: none; }
  .back a:hover { color: var(--paper); }
  h1 { font-size: var(--step-5); }
  .forces {
    margin: 1.25rem 0 0;
    font-size: var(--step-1);
    font-style: italic;
    font-weight: 300;
    color: var(--ash);
    line-height: 1.35;
    max-width: 40ch;
  }
  .facts {
    grid-column: 9 / span 4;
    margin: 0;
    border-top: 1px solid var(--graphite);
  }
  .facts div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--graphite);
    font-size: 0.9375rem;
  }
  .facts dt { color: var(--ash); }
  .facts dd { margin: 0; }
  .facts a { text-decoration-color: var(--smoke); }

  .body { margin-top: clamp(3rem, 7vw, 6rem); row-gap: 2rem; align-items: start; }
  .lead { grid-column: 1 / span 7; }
  .lead p:first-child { font-size: var(--step-1); line-height: 1.45; font-weight: 300; }
  .mapping { font-size: var(--step-0); }
  .prose { grid-column: 1 / span 7; }
  .side-image { grid-column: 9 / span 4; grid-row: 1 / span 2; position: sticky; top: calc(var(--header-h) + 2rem); }
  .prose :global(h2) {
    font-size: var(--step-2);
    margin: 3rem 0 1rem;
  }
  .prose :global(p) { margin-bottom: 1.1em; }

  .cover { margin-top: clamp(4rem, 9vw, 8rem); }
  .piece :global(.inverted img) { filter: invert(0.92) hue-rotate(180deg); background: transparent; }

  .more { margin-top: clamp(3rem, 6vw, 5rem); row-gap: 3rem; align-items: start; }
  .more-item.m0 { grid-column: 1 / span 7; }
  .more-item.m1 { grid-column: 9 / span 4; margin-top: clamp(0rem, 12vw, 10rem); }

  .section-title { font-size: var(--step-3); grid-column: 1 / -1; margin-bottom: 2rem; }
  .listen { margin-top: clamp(5rem, 10vw, 9rem); row-gap: 1rem; align-items: start; }
  .audio { grid-column: 1 / span 5; }
  .video { grid-column: 7 / span 6; }
  .audio + .video { margin-top: 0; }
  .listen:not(:has(.audio)) .video { grid-column: 1 / span 8; }
  .listen:not(:has(.video)) .audio { grid-column: 1 / span 7; }

  .perf { margin-top: clamp(5rem, 10vw, 9rem); }
  .perf .section-title { margin-bottom: 0.75rem; }
  .perf-note { margin-bottom: 2rem; font-size: 1rem; }

  .pager {
    margin-top: clamp(5rem, 10vw, 8rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--graphite);
    font-size: 1rem;
  }
  .pager a { text-decoration: none; }
  .pager a:hover { text-decoration: underline; }
  .pager .all { color: var(--ash); }
  .pager .next { text-align: right; }
  .pager span.dim { margin-right: 0.4rem; }

  @media (max-width: 960px) {
    .title, .facts, .lead, .prose, .side-image, .audio, .video, .more-item.m0, .more-item.m1 { grid-column: 1 / -1; }
    .side-image { grid-row: auto; position: static; }
    .more-item.m1 { margin-top: 0; }
    .listen:not(:has(.audio)) .video, .listen:not(:has(.video)) .audio { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .pager { grid-template-columns: 1fr 1fr; }
    .pager .all { display: none; }
  }
</style>
