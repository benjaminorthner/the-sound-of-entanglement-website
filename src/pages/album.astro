---
/**
 * The album "Sounds of Entanglement" by The Uncertain Question: recorded,
 * not yet released. Facts: docs/pieces.md, docs/project.md. Release date,
 * label, track list and artwork are unknown; don't invent them.
 * Studio photos: src/assets/photos/2026-album-studio/ (photographer to be
 * confirmed, see docs/open-questions.md).
 */
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Vinyl from '../components/album/Vinyl.astro';
import experiment from '../assets/photos/2026-album-studio/experiment-in-studio.jpg';
import aligning from '../assets/photos/2026-album-studio/aligning-in-studio.jpg';
import controlRoom from '../assets/photos/2026-album-studio/control-room.jpg';
import engineer from '../assets/photos/2026-album-studio/engineer-at-desk.jpg';
import drumsRoom from '../assets/photos/2026-album-studio/drums-room.jpg';
import drumsClose from '../assets/photos/2026-album-studio/drums-close.jpg';
import bassKeys from '../assets/photos/2026-album-studio/bass-and-keys.jpg';
import keysPortrait from '../assets/photos/2026-album-studio/keys-portrait.jpg';
import keysOverhead from '../assets/photos/2026-album-studio/keys-overhead.jpg';

const C = 'Benjamin Orthner';
const lineup = [
  { name: 'Clemens Wenger', role: 'keys, synthesizers, VoQoder' },
  { name: 'Manu Mayr', role: 'electric bass' },
  { name: 'Judith Schwarz', role: 'drums' },
];
---
<Base title="Sounds of Entanglement, the album" description="Sounds of Entanglement by The Uncertain Question: music conducted by pairs of entangled photons, recorded live with the experiment in the studio. Coming on vinyl and digital." image={aligning} imageAlt="Benjamin Orthner aligning the optics of the experiment in the recording studio.">
  <section class="wrap grid hero" aria-labelledby="album-title">
    <div class="record"><Vinyl size="hero" playable /></div>
    <div class="head">
      <p class="ui dim kicker">The Uncertain Question</p>
      <h1 id="album-title">Sounds of Entanglement</h1>
      <p class="status">Recorded. Not released yet. Vinyl and digital.</p>
      <p class="dim">Release date, track list and artwork to follow.</p>
    </div>
  </section>

  <section class="wrap grid intro" aria-label="About the album">
    <div class="text">
      <p class="lead">
        The first album of music conducted by pairs of entangled photons.
      </p>
      <p>
        The Uncertain Question, the band that plays <a href="/pieces/8-rooms/"><em>8 Rooms</em></a> and
        <a href="/pieces/indeterminate-apparatus/"><em>Indeterminate Apparatus</em></a> on stage, recorded it
        the way it plays in concert: live, with the experiment running in the room. The photon pairs measured
        during the takes decided what the band had to respond to, so no take could have been played the same
        way twice.
      </p>
    </div>
  </section>

  <!-- The experiment in the studio -->
  <section class="wrap grid chapter experiment" aria-labelledby="ch-experiment">
    <div class="portrait">
      <Photo src={experiment} credit={C} alt="The experiment in its open flight case in the recording studio, two laptops beside it, a microphone stand behind." caption="The experiment in the live room." sizes="(min-width: 1000px) 30vw, 100vw" />
    </div>
    <div class="text">
      <h2 id="ch-experiment">An experiment in the live room</h2>
      <p>
        The optics travelled to the studio in their flight case and were set up next to the band, as at every
        concert. Before recording, the fibres have to be aligned again by hand until the photon pairs are
        counted cleanly.
      </p>
    </div>
    <div class="wide">
      <Photo src={aligning} credit={C} alt="Benjamin Orthner leans over the breadboard, adjusting the optics with one hand." caption="Benjamin Orthner aligning the optics in the studio." sizes="(min-width: 1000px) 58vw, 100vw" />
    </div>
  </section>

  <!-- Control room -->
  <section class="chapter control" aria-labelledby="ch-control">
    <div class="wrap"><Photo src={controlRoom} credit={C} alt="The control room: a large mixing desk, monitors and a screen showing the live room, the engineer at the computer." sizes="100vw" /></div>
    <div class="wrap grid">
      <div class="text">
        <h2 id="ch-control">The control room</h2>
        <p>On the other side of the glass, the takes are recorded and mixed.</p>
      </div>
      <div class="side"><Photo src={engineer} credit={C} alt="The engineer at the desk, talking to the band over the talkback microphone." sizes="(min-width: 1000px) 34vw, 100vw" /></div>
    </div>
  </section>

  <!-- The band -->
  <section class="wrap grid chapter band" aria-labelledby="ch-band">
    <div class="text">
      <h2 id="ch-band">The band</h2>
      <ul class="lineup">
        {lineup.map((m) => (
          <li><span class="name">{m.name}</span> <span class="dim">{m.role}</span></li>
        ))}
      </ul>
      <p class="ui more"><a href="/people/">About the people</a></p>
    </div>
    <div class="b1"><Photo src={drumsRoom} credit={C} alt="The drummer in the live room, seen from above between the acoustic panels." sizes="(min-width: 1000px) 58vw, 100vw" /></div>
    <div class="b2"><Photo src={drumsClose} credit={C} alt="Close to the drum kit: cymbals, a red tom, the drummer behind them." sizes="(min-width: 1000px) 34vw, 100vw" /></div>
  </section>

  <div class="wrap bass"><Photo src={bassKeys} credit={C} alt="In the live room: a bass player in headphones in front, the keyboard player behind at his instruments." sizes="100vw" /></div>

  <div class="wrap grid keys">
    <div class="k1"><Photo src={keysPortrait} credit={C} alt="The keyboard player raises one arm while playing, surrounded by keyboards and cables." sizes="(min-width: 1000px) 34vw, 100vw" /></div>
    <div class="k2"><Photo src={keysOverhead} credit={C} alt="The keyboard setup from above: two keyboards, a laptop, cables across the floor." sizes="(min-width: 1000px) 34vw, 100vw" /></div>
  </div>

  <section class="wrap grid news" aria-labelledby="ch-news">
    <div class="text">
      <h2 id="ch-news">Coming</h2>
      <p>
        Release date, track list and artwork will be announced here. For news about the album, or to book the
        band with the experiment, write to us.
      </p>
      <p class="ui links">
        <a href="mailto:clemenswenger@mac.com">clemenswenger@mac.com</a>
        <a href="/booking/">Booking</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 6rem);
    align-items: center;
    row-gap: 3rem;
  }
  .record { grid-column: 1 / span 6; }
  .head { grid-column: 8 / span 5; }
  .kicker { margin: 0 0 1rem; font-size: 1rem; }
  h1 { font-size: var(--step-5); }
  .status { margin-top: 1.75rem; font-size: var(--step-1); font-weight: 300; }

  .intro { margin-top: clamp(5rem, 10vw, 8rem); }
  .intro .text { grid-column: 2 / span 7; }
  .lead { font-size: var(--step-2); font-weight: 300; line-height: 1.3; font-family: var(--font-display); }
  .text a { text-decoration-color: var(--smoke); }

  .chapter { margin-block: clamp(5rem, 10vw, 9rem); }
  h2 { font-size: var(--step-3); margin-bottom: 1.25rem; }

  .experiment { align-items: start; row-gap: 2.5rem; }
  .experiment .portrait { grid-column: 1 / span 4; grid-row: 1 / span 2; }
  .experiment .text { grid-column: 6 / span 6; }
  .experiment .wide { grid-column: 6 / span 7; }

  .control .grid { margin-top: 2.5rem; align-items: start; row-gap: 2rem; }
  .control .text { grid-column: 2 / span 5; }
  .control .side { grid-column: 8 / span 5; }

  .band { align-items: start; row-gap: 2.5rem; }
  .band .text { grid-column: 1 / span 4; }
  .band .b1 { grid-column: 6 / span 7; }
  .band .b2 { grid-column: 2 / span 4; margin-top: clamp(0rem, 4vw, 3rem); }
  .lineup { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--graphite); }
  .lineup li { padding-block: 0.7rem; border-bottom: 1px solid var(--graphite); display: flex; flex-wrap: wrap; gap: 0 0.6rem; }
  .name { font-family: var(--font-display); }
  .more { margin-top: 1.25rem; font-size: 1rem; }

  .bass { margin-top: clamp(3rem, 6vw, 5rem); }
  .keys { margin-top: clamp(3rem, 6vw, 5rem); align-items: start; row-gap: 2rem; }
  .keys .k1 { grid-column: 3 / span 4; }
  .keys .k2 { grid-column: 8 / span 4; margin-top: clamp(0rem, 8vw, 7rem); }

  .news { margin-block: clamp(5rem, 10vw, 9rem) 0; border-top: 1px solid var(--graphite); padding-top: clamp(3rem, 6vw, 5rem); }
  .news .text { grid-column: 2 / span 7; }
  .links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; font-size: 1rem; }

  @media (max-width: 900px) {
    .record, .head, .intro .text, .experiment .portrait, .experiment .text, .experiment .wide,
    .control .text, .control .side, .band .text, .band .b1, .band .b2, .news .text { grid-column: 1 / -1; grid-row: auto; }
    .keys .k1, .keys .k2 { grid-column: span 6; margin-top: 0; }
    .head { order: -1; }
    .experiment .portrait { max-width: 70%; }
  }
</style>
