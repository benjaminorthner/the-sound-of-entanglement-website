---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  /** Let the first section run under the transparent header (full-bleed heroes). */
  underHeader?: boolean;
}
const {
  title,
  description = 'Pairs of entangled photons conduct a live audiovisual performance. An art–science project by musicians, artists and quantum physicists.',
  underHeader = false,
} = Astro.props;
const fullTitle = title ? `${title} · The Sound of Entanglement` : 'The Sound of Entanglement';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#000000" />
    {/* Preview phase: keep out of search engines until photo rights are cleared (docs/open-questions.md). Remove for launch, together with public/robots.txt. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
    />
  </head>
  <body>
    <a class="skip ui" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={{ 'under-header': underHeader }}>
      <slot />
    </main>
    <Footer />
    <style>
      main { padding-top: var(--header-h); }
      main.under-header { padding-top: 0; }
      .skip {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 100;
        background: var(--paper);
        color: var(--black);
        padding: 0.5rem 1rem;
      }
      .skip:focus { top: 1rem; }
    </style>
  </body>
</html>
