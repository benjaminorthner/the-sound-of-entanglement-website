---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title?: string;
  description?: string;
  /** Let the first section run under the transparent header (full-bleed heroes). */
  underHeader?: boolean;
  /** Share preview image (Signal, WhatsApp, social). Defaults to the title card. */
  image?: ImageMetadata;
  imageAlt?: string;
}
const {
  title,
  description = 'Pairs of entangled photons conduct a live audiovisual performance. An art–science project by musicians, artists and quantum physicists.',
  underHeader = false,
  image,
  imageAlt,
} = Astro.props;
const site = Astro.site ?? new URL('https://the-sound-of-entanglement.vercel.app');
const og = image
  ? new URL((await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 80 })).src, site).href
  : new URL('/og/default.jpg', site).href;
const ogAlt = image ? (imageAlt ?? '') : 'The Sound of Entanglement: the title over the optics of the experiment, with its two red rotation mounts.';
const canonical = new URL(Astro.url.pathname, site).href;
const fullTitle = title ? `${title} · The Sound of Entanglement` : 'The Sound of Entanglement';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Sound of Entanglement" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={og} />
    <meta name="theme-color" content="#000000" />
    {/* Preview phase: keep out of search engines until photo rights are cleared (docs/open-questions.md). Remove for launch, together with public/robots.txt. */}
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Josefin+Sans:wght@300;400;600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..600&display=swap"
    />
  </head>
  <body>
    <a class="skip ui" href="#main">Skip to content</a>
    <Header />
    <main id="main" class:list={{ 'under-header': underHeader }}>
      <slot />
    </main>
    <Footer />
    <style>
      main { padding-top: var(--header-h); }
      main.under-header { padding-top: 0; }
      .skip {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 100;
        background: var(--paper);
        color: var(--black);
        padding: 0.5rem 1rem;
      }
      .skip:focus { top: 1rem; }
    </style>
  </body>
</html>
