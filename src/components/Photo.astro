---
/**
 * A photo with its credit. Every image on the site goes through this so the
 * credit can't be forgotten. `bleed` makes it span the full viewport width.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLang, useT } from '../i18n';
import { photosDe, photoKey } from '../i18n/photos.de';

interface Props {
  src: ImageMetadata;
  alt: string;
  credit: string;
  caption?: string;
  sizes?: string;
  bleed?: boolean;
  loading?: 'lazy' | 'eager';
  class?: string;
  /** CSS aspect-ratio to crop to, e.g. "16 / 9". */
  ratio?: string;
}
const { src, credit, caption, sizes = '100vw', bleed = false, loading = 'lazy', ratio } = Astro.props;
const lang = getLang(Astro);
const t = useT(lang);
// Alt text belongs to the image: on German pages it comes from src/i18n/photos.de.ts
// (English fallback). Captions are context and are translated by the caller.
const alt = lang === 'de' ? (photosDe[photoKey(src.src)]?.alt ?? Astro.props.alt) : Astro.props.alt;
const widths = [480, 800, 1200, 1600, 2000, 2400].filter((w) => w <= src.width);
---
<figure class:list={['photo', { bleed }, Astro.props.class]} style={ratio ? `--ratio: ${ratio}` : undefined}>
  <Image src={src} alt={alt} widths={widths} sizes={sizes} loading={loading} format="webp" quality={82} />
  <figcaption class="ui">
    {caption && <span class="caption">{caption}</span>}
    <span class="credit">{credit.startsWith('©') ? credit : `${t('photo.credit')}: ${credit}`}</span>
  </figcaption>
</figure>

<style>
  .photo { margin: 0; }
  .photo :global(img) {
    width: 100%;
    height: auto;
    background: var(--soot);
  }
  .photo[style] :global(img) {
    aspect-ratio: var(--ratio);
    object-fit: cover;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.6rem;
    color: var(--smoke);
    font-size: 0.8125rem;
    line-height: 1.4;
  }
  .caption { color: var(--ash); }
  .bleed figcaption { padding-inline: var(--gutter); }
</style>
