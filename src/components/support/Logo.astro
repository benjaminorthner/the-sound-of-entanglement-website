---
/**
 * One supporter logo, sized by visual weight (see logoHeight), linked to the
 * organisation. Falls back to the name as text when there is no logo.
 */
import { Image } from 'astro:assets';
import type { Supporter } from './data';
import { logoHeight, supporterText } from './data';
import { getLang } from '../../i18n';

interface Props {
  supporter: Supporter;
  /** Target area in px² for a logo with scale 1. */
  area?: number;
  min?: number;
  max?: number;
}
const { supporter, area = 9000, min = 22, max = 64 } = Astro.props;
const { url, logo, scale } = supporter.data;
const { name } = supporterText(supporter, getLang(Astro));
const h = logo ? logoHeight(logo.width, logo.height, scale, area, min, max) : 0;
const Tag = url ? 'a' : 'span';
---
<Tag class:list={['logo', { text: !logo }]} href={url} title={logo ? name : undefined}>
  {logo ? (
    <Image src={logo} alt={name} height={h} densities={[1, 2]} format="webp" loading="lazy" />
  ) : (
    <span>{name}</span>
  )}
</Tag>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    color: var(--paper);
    text-decoration: none;
    opacity: 0.86;
    transition: opacity 0.2s ease;
  }
  a.logo:hover { opacity: 1; }
  a.logo:focus-visible { outline-offset: 6px; }
  .logo :global(img) { display: block; width: auto; }
  .text span {
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.3;
    max-width: 18ch;
  }
</style>
