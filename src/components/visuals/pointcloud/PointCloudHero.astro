---
/**
 * Landing hero. A pinned scroll sequence (about 300vh) over the 3D scan of
 * the experiment: wide shot with the title, source and crystal, Alice & Bob,
 * top-down. Real premiere events flash the detectors.
 *
 * Without WebGL, with reduced motion, or without JavaScript, the hero is a
 * static photograph with the same text stacked below the title.
 */
import { Image } from 'astro:assets';
import fallback from '../../../assets/photos/setup/case-top-view.jpg';

const stops = [
  {
    id: 'source',
    text: 'A violet laser shines into a crystal. About one photon in a hundred billion splits into two infrared photons that are entangled.',
  },
  {
    id: 'arms',
    text: 'One photon goes to Alice, the other to Bob. On each side a motor turns a wave plate to one of two settings, chosen at random.',
  },
  {
    id: 'detectors',
    text: 'Each photon lands in one of two detectors. On its own, every click is chance. Compared side by side, the clicks agree more often than anything classical allows.',
  },
];
---
<script is:inline>
  // Decide before first paint whether the live hero can run.
  (function () {
    var ok = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (ok) {
      try {
        var c = document.createElement('canvas');
        ok = !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch (e) {
        ok = false;
      }
    }
    if (ok) document.documentElement.dataset.hero = 'live';
  })();
</script>

<section class="hero" aria-labelledby="hero-title" data-hero-root>
  <div class="stage">
    <canvas class="scene" aria-hidden="true"></canvas>
    <div class="fallback">
      <Image
        src={fallback}
        alt="The experiment seen from above in its lit glass case: a laser source, mirrors, red rotation mounts and fibre-coupled detectors on a black breadboard."
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        format="webp"
      />
      <p class="credit ui">Photo: Benjamin Orthner</p>
    </div>

    <div class="wrap copy">
      <div class="stop stop-0" data-stop="0">
        <h1 id="hero-title"><span>The Sound of</span> <span>Entanglement</span></h1>
        <p class="lede">Pairs of entangled photons conduct a live audiovisual performance.</p>
        <p class="readout">
          <span class="live-only">
            This is a 3D scan of the experiment. Each flash is a photon pair measured at the premiere in the
            Mariendom Linz on 4 September 2024, replayed at the pace it happened: pair{' '}
            <span class="num" data-pair>0</span>, measured at <span class="num" data-clock>23:00:10</span>.
          </span>
          <span class="static-only">The experiment we take on stage: a Bell test in a glass case.</span>
        </p>
      </div>
      {stops.map((s, i) => (
        <div class:list={['stop', `stop-${i + 1}`]} data-stop={i + 1} id={`hero-${s.id}`}>
          <p>{s.text}</p>
          {s.id === 'detectors' && (
            <p class="bell live-only">
              <span data-s>The Bell value is still settling.</span>{' '}
              A classical conductor can't go above 2.
            </p>
          )}
        </div>
      ))}
    </div>

    <p class="scroll-hint ui live-only" aria-hidden="true">Scroll to follow the light</p>
  </div>
</section>

<script>
  import { createScene, type PointCloudScene } from './scene';
  import { decodeExcerpt, Replay, RunningS, clock, type Excerpt } from '../../../lib/replay';
  import premiere from '../../../data/bruqner_premiere_2024-09-04.json';

  const hero = document.querySelector<HTMLElement>('[data-hero-root]')!;
  const live = document.documentElement.dataset.hero === 'live';

  if (live) {
    const canvas = hero.querySelector<HTMLCanvasElement>('canvas')!;
    const stops = [...hero.querySelectorAll<HTMLElement>('[data-stop]')];
    const pairEl = hero.querySelector('[data-pair]')!;
    const clockEl = hero.querySelector('[data-clock]')!;
    const sEl = hero.querySelector('[data-s]')!;
    const COUNT = 3; // stops after the first

    /** Scroll progress through the pinned hero, 0..COUNT, with holds at each stop. */
    const progress = () => {
      const travel = hero.offsetHeight - innerHeight;
      const raw = Math.min(1, Math.max(0, (scrollY - hero.offsetTop) / Math.max(1, travel))) * COUNT;
      const i = Math.min(COUNT - 1, Math.floor(raw));
      const f = raw - i;
      const held = Math.min(1, Math.max(0, (f - 0.2) / 0.6)); // hold 20% at each end of a segment
      return i + held;
    };

    const updateText = (p: number) => {
      stops.forEach((el, i) => {
        const o = Math.max(0, 1 - Math.abs(p - i) * 2.2);
        el.style.opacity = String(o);
        el.style.visibility = o < 0.02 ? 'hidden' : 'visible';
        el.style.transform = `translateY(${(i - p) * 24}px)`;
      });
      hero.style.setProperty('--hint', String(Math.max(0, 1 - p * 4)));
    };

    let scene: PointCloudScene | undefined;
    let visible = true;
    const running = new RunningS();

    const onScroll = () => {
      const p = progress();
      updateText(p);
      scene?.setProgress(p);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      scene?.setRunning(visible && !document.hidden);
    }).observe(hero);
    document.addEventListener('visibilitychange', () => scene?.setRunning(visible && !document.hidden));

    createScene(canvas, '/media/setup-pointcloud.bin')
      .then((s) => {
        scene = s;
        onScroll();
        const events = decodeExcerpt(premiere as Excerpt);
        const replay = new Replay(events, (e) => {
          running.add(e);
          pairEl.textContent = String(e.n + 1);
          clockEl.textContent = clock(e);
          sEl.textContent =
            running.n < 60
              ? `The Bell value is still settling (${running.n} pairs so far).`
              : `Bell value so far: S = ${running.S.toFixed(2)}, from ${running.n.toLocaleString('en')} pairs.`;
          if (visible) scene?.pulse(e);
        });
        setTimeout(() => replay.start(), 1800);
      })
      .catch(() => {
        document.documentElement.dataset.hero = '';
      });
  }
</script>

<style>
  .hero { position: relative; }
  .stage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .scene { display: none; }

  /* Static version (default): photo with the text stacked on top of it. */
  .fallback {
    position: absolute;
    inset: 0;
  }
  .fallback :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6);
  }
  /* keeps the stacked text readable over the photograph */
  .fallback::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.7) 40%, rgb(0 0 0 / 0.1) 75%);
  }
  @media (max-width: 760px) {
    .fallback::after { background: rgb(0 0 0 / 0.72); }
  }
  .fallback .credit {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
    margin: 0;
    color: var(--smoke);
    font-size: 0.8125rem;
  }
  .copy {
    position: relative;
    padding-block: calc(var(--header-h) + 4rem) 4rem;
  }
  .stop { max-width: 38rem; }
  .stop + .stop { margin-top: 1.5rem; }
  .stop p { font-size: var(--step-1); line-height: 1.45; }
  h1 {
    font-size: clamp(2.75rem, 1.2rem + 5.4vw, 6.25rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }
  h1 span { display: block; }
  .lede { margin-top: 1.5rem; font-size: var(--step-1); max-width: 22ch; }
  .readout { margin-top: 1.5rem; color: var(--ash); font-size: 1rem; line-height: 1.55; max-width: 30rem; }
  .readout .num { color: var(--paper); }
  .live-only { display: none; }
  .bell { margin-top: 1rem; font-size: 1rem; color: var(--ash); }
  .bell .num { color: var(--paper); }

  /* Live version: a pinned stage with the scan and one stop visible at a time. */
  :global(html[data-hero='live']) .hero { height: 320vh; }
  :global(html[data-hero='live']) .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  :global(html[data-hero='live']) .scene {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  :global(html[data-hero='live']) .fallback,
  :global(html[data-hero='live']) .static-only { display: none; }
  :global(html[data-hero='live']) .live-only { display: inline; }
  :global(html[data-hero='live']) p.live-only { display: block; }
  :global(html[data-hero='live']) .copy {
    position: absolute;
    inset: 0;
    margin-inline: auto;
    padding: 0 var(--gutter);
    pointer-events: none;
  }
  :global(html[data-hero='live']) .stop {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    width: min(38rem, 44vw);
    margin: 0;
    will-change: opacity, transform;
  }
  :global(html[data-hero='live']) .stop-0 { top: auto; bottom: 12vh; translate: none; }
  :global(html[data-hero='live']) .stop a { pointer-events: auto; }

  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    translate: -50% 0;
    margin: 0;
    color: var(--ash);
    font-size: 0.8125rem;
    opacity: var(--hint, 1);
  }
  .scroll-hint::after {
    content: '';
    display: block;
    width: 1px;
    height: 28px;
    margin: 0.6rem auto 0;
    background: linear-gradient(var(--ash), transparent);
  }

  @media (min-width: 1500px) {
    :global(html[data-hero='live']) .stop { left: calc((100vw - var(--max)) / 2 + var(--gutter)); }
  }

  @media (max-width: 760px) {
    :global(html[data-hero='live']) .stop {
      top: auto;
      bottom: 4.5rem;
      translate: none;
      width: auto;
      right: var(--gutter);
    }
    :global(html[data-hero='live']) .stop-0 { bottom: 4.5rem; }
    .stop p { font-size: 1.1875rem; }
    .readout { font-size: 0.875rem; }
  }
</style>
