---
/**
 * Landing hero. A pinned scroll sequence (about 300vh) over the 3D scan of
 * the experiment: wide shot with the title, source and crystal, Alice & Bob,
 * top-down. Real premiere events flash the detectors.
 *
 * Without WebGL, with reduced motion, or without JavaScript, the hero is a
 * static photograph with the same text stacked below the title.
 */
import { Image } from 'astro:assets';
import fallback from '../../../assets/photos/setup/case-top-view.jpg';
import { getLang, useT } from '../../../i18n';

const lang = getLang(Astro);
const t = useT(lang);
const de = lang === 'de';
const stops = [
  {
    id: 'source',
    text: de
      ? 'Ein violetter Laser leuchtet in einen Kristall. Etwa eines von hundert Milliarden Photonen teilt sich dort in zwei infrarote Photonen, die miteinander verschränkt sind.'
      : 'A violet laser shines into a crystal. About one photon in a hundred billion splits into two infrared photons that are entangled.',
  },
  {
    id: 'arms',
    text: de
      ? 'Ein Photon fliegt zu Alice, das andere zu Bob. Auf beiden Seiten dreht ein Motor eine Wellenplatte auf eine von zwei Einstellungen, zufällig gewählt.'
      : 'One photon goes to Alice, the other to Bob. On each side a motor turns a wave plate to one of two settings, chosen at random.',
  },
  {
    id: 'detectors',
    text: de
      ? 'Jedes Photon landet in einem von zwei Detektoren. Für sich genommen ist jeder Klick Zufall. Vergleicht man beide Seiten, stimmen die Klicks öfter überein, als es in der klassischen Physik möglich wäre.'
      : 'Each photon lands in one of two detectors. On its own, every click is chance. Compared side by side, the clicks agree more often than anything classical allows.',
  },
];
---
<script is:inline>
  // Decide before first paint whether the live hero can run.
  (function () {
    var ok = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (ok) {
      try {
        var c = document.createElement('canvas');
        ok = !!(c.getContext('webgl2') || c.getContext('webgl'));
      } catch (e) {
        ok = false;
      }
    }
    if (ok) {
      document.documentElement.dataset.hero = 'live';
      // Watchdog: if the hero's module script never runs (failed to load or
      // blocked), fall back to the static hero. Load errors after the script
      // has started are handled there.
      setTimeout(function () {
        if (!window.__heroBoot) document.documentElement.dataset.hero = '';
      }, 6000);
    }
  })();
</script>

<section class="hero" aria-labelledby="hero-title" data-hero-root>
  <div class="stage">
    <canvas class="scene" aria-hidden="true"></canvas>
    <div class="fallback">
      <Image
        src={fallback}
        alt={de
          ? 'Das Experiment von oben in seinem beleuchteten Glaskasten: eine Laserquelle, Spiegel, rote Drehhalterungen und fasergekoppelte Detektoren auf einer schwarzen Lochrasterplatte.'
          : 'The experiment seen from above in its lit glass case: a laser source, mirrors, red rotation mounts and fibre-coupled detectors on a black breadboard.'}
        widths={[800, 1200, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        format="webp"
      />
      <p class="credit ui">{t('photo.credit')}: Benjamin Orthner</p>
    </div>

    <div class="wrap copy">
      <div class="stop stop-0" data-stop="0">
        <h1 id="hero-title"><span>The Sound of</span> <span>Entanglement</span></h1>
        {de ? (
          <>
            <p class="lede">Verschränkte Photonenpaare dirigieren eine audiovisuelle Live-Performance.</p>
            <p class="readout">
              <span class="live-only">
                Ein 3D-Scan des Experiments, dazu Photonenpaare, die bei der Uraufführung im Mariendom Linz am
                4. September 2024 gemessen wurden. Gezeigt wird jeweils ein Paar, verlangsamt.
              </span>
              <span class="static-only">Das Experiment, mit dem wir auf der Bühne stehen: ein Bell-Test im Glaskasten.</span>
            </p>
          </>
        ) : (
          <>
            <p class="lede">Pairs of entangled photons conduct a live audiovisual performance.</p>
            <p class="readout">
              <span class="live-only">
                A 3D scan of the experiment, replaying photon pairs measured at the premiere in the Mariendom Linz on
                4 September 2024. One pair at a time is drawn, slowed down.
              </span>
              <span class="static-only">The experiment we take on stage: a Bell test in a glass case.</span>
            </p>
          </>
        )}
      </div>
      {stops.map((s, i) => (
        <div class:list={['stop', `stop-${i + 1}`]} data-stop={i + 1} id={`hero-${s.id}`}>
          <p>{s.text}</p>
        </div>
      ))}
    </div>

    <div class="labels" data-labels aria-hidden="true"></div>

    <p
      class="tally ui live-only waiting"
      data-tally
      data-lang={lang}
      data-settling={de ? 'S pendelt sich noch ein' : 'S still settling'}
      title={de
        ? 'Zähler und Bell-Wert folgen der Aufnahme in ihrem echten Tempo. Gezeichnet wird verlangsamt immer nur ein Paar; die übrigen laufen unsichtbar mit.'
        : 'The count and the Bell value follow the recording at its real pace. One pair at a time is drawn, slowed down; the others pass unseen.'}
    >
      <span class="tally-pair">{de ? 'Paar' : 'Pair'} <span class="num" data-pair>–</span>, <span class="num" data-clock>–</span>.</span>
      <span>Alice <span class="num" data-a-out>–</span>, Bob <span class="num" data-b-out>–</span>.</span>
      <span class="num" data-s>–</span>
    </p>

    <span class="scroll-hint live-only" aria-hidden="true"></span>
  </div>
</section>

<script>
  import type { PointCloudScene, DetectInfo } from './scene';
  import { decodeExcerpt, Replay, RunningS, clock, type Excerpt, type ReplayEvent } from '../../../lib/replay';
  import premiere from '../../../data/bruqner_premiere_2024-09-04.json';

  (window as unknown as { __heroBoot?: boolean }).__heroBoot = true;
  const hero = document.querySelector<HTMLElement>('[data-hero-root]')!;
  const live = document.documentElement.dataset.hero === 'live';

  if (live) {
    const canvas = hero.querySelector<HTMLCanvasElement>('canvas')!;
    const stops = [...hero.querySelectorAll<HTMLElement>('[data-stop]')];
    const $ = (sel: string) => hero.querySelector<HTMLElement>(sel)!;
    const el = {
      pair: $('[data-pair]'),
      clock: $('[data-clock]'),
      aOut: $('[data-a-out]'),
      bOut: $('[data-b-out]'),
      s: $('[data-s]'),
    };
    const COUNT = 3; // stops after the first

    /** Scroll progress through the pinned hero, 0..COUNT, with holds at each stop. */
    const progress = () => {
      const travel = hero.offsetHeight - innerHeight;
      const raw = Math.min(1, Math.max(0, (scrollY - hero.offsetTop) / Math.max(1, travel))) * COUNT;
      const i = Math.min(COUNT - 1, Math.floor(raw));
      const f = raw - i;
      const held = Math.min(1, Math.max(0, (f - 0.2) / 0.6)); // hold 20% at each end of a segment
      return i + held;
    };

    const updateText = (p: number) => {
      stops.forEach((el, i) => {
        const o = Math.max(0, 1 - Math.abs(p - i) * 2.2);
        el.style.opacity = String(o);
        el.style.visibility = o < 0.02 ? 'hidden' : 'visible';
        el.style.transform = `translateY(${(i - p) * 24}px)`;
      });
      hero.style.setProperty('--hint', String(Math.max(0, 1 - p * 4)));
    };

    let scene: PointCloudScene | undefined;
    let visible = true;
    const running = new RunningS();
    let latest: ReplayEvent | undefined;
    let replay: Replay | undefined;

    const onScroll = () => {
      const p = progress();
      updateText(p);
      scene?.setProgress(p);
    };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();

    const setRunning = () => {
      const on = visible && !document.hidden;
      scene?.setRunning(on);
      if (!replay) return;
      if (on && !replay.running) replay.start();
      if (!on && replay.running) replay.stop();
    };
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      setRunning();
    }).observe(hero);
    document.addEventListener('visibilitychange', setRunning);

    const showS = () => {
      const tally = $('[data-tally]');
      const value = running.S.toLocaleString(tally.dataset.lang === 'de' ? 'de-AT' : 'en-GB', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });
      el.s.textContent = running.n < 60 ? tally.dataset.settling! : `S = ${value}`;
    };
    const sign = (x: number) => (x === 1 ? '+1' : '−1');
    const onDetect = ({ e, colours }: DetectInfo) => {
      el.pair.textContent = String(e.n + 1);
      el.clock.textContent = clock(e);
      el.aOut.textContent = sign(e.A);
      el.bOut.textContent = sign(e.B);
      el.aOut.style.color = colours[0];
      el.bOut.style.color = colours[1];
      $('[data-tally]').classList.remove('waiting');
      showS();
    };

    // Dynamic import so a failure to load three.js is caught below and the
    // static hero takes over, instead of leaving a half-initialised page.
    import('./scene')
      .then(({ createScene }) =>
        createScene(canvas, '/media/setup-pointcloud-hd.bin', { overlay: $('[data-labels]'), onDetect }),
      )
      .then(async (s) => {
        scene = s;
        onScroll();
        const events = decodeExcerpt(premiere as Excerpt);
        // The recording runs at its real pace; the counter and S follow it.
        replay = new Replay(events, (e) => {
          running.add(e);
          latest = e;
          if (running.n % 5 === 0) showS();
        });
        await s.ready;
        setRunning();
        // Draw the most recent pair whenever the previous drawing has finished.
        let drawn = -1;
        for (;;) {
          const e = latest && latest.n !== drawn ? latest : undefined;
          if (!e) {
            await new Promise((r) => setTimeout(r, 120));
            continue;
          }
          drawn = e.n;
          await s.play(e);
        }
      })
      .catch((err) => {
        console.error('Point-cloud hero failed, showing the static version.', err);
        document.documentElement.dataset.hero = '';
      });
  }
</script>

<style>
  .hero { position: relative; }
  .stage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }
  .scene { display: none; }

  /* Static version (default): photo with the text stacked on top of it. */
  .fallback {
    position: absolute;
    inset: 0;
  }
  .fallback :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.6);
  }
  /* keeps the stacked text readable over the photograph */
  .fallback::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.9) 0%, rgb(0 0 0 / 0.7) 40%, rgb(0 0 0 / 0.1) 75%);
  }
  @media (max-width: 760px) {
    .fallback::after { background: rgb(0 0 0 / 0.72); }
  }
  .fallback .credit {
    position: absolute;
    right: var(--gutter);
    bottom: 1rem;
    margin: 0;
    color: var(--smoke);
    font-size: 0.8125rem;
  }
  .copy {
    position: relative;
    padding-block: calc(var(--header-h) + 4rem) 4rem;
  }
  .stop { max-width: 38rem; }
  .stop + .stop { margin-top: 1.5rem; }
  .stop p { font-size: var(--step-1); line-height: 1.45; }
  h1 {
    font-size: clamp(2.75rem, 1.2rem + 5.4vw, 6.25rem);
    line-height: 1;
    letter-spacing: -0.015em;
  }
  h1 span { display: block; }
  .lede { margin-top: 1.5rem; font-size: var(--step-1); max-width: 22ch; }
  .readout { margin-top: 1.5rem; color: var(--ash); font-size: 1rem; line-height: 1.55; max-width: 30rem; }
  .readout .num { color: var(--paper); }
  .live-only { display: none; }
  .labels { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .labels :global(.pc-label) {
    position: absolute;
    left: 0;
    top: 0;
    font-family: var(--font-display);
    font-size: 0.9375rem;
    letter-spacing: 0.02em;
    opacity: 0;
    text-shadow: 0 0 12px rgb(0 0 0 / 0.9);
    font-variant-numeric: tabular-nums;
  }
  .labels :global(.pc-name) {
    color: var(--paper);
    font-size: 0.875rem;
    letter-spacing: 0.06em;
  }

  /* One quiet line: the pair being drawn and the running Bell value. */
  .tally {
    position: absolute;
    right: var(--gutter);
    bottom: 1.6rem;
    margin: 0;
    display: flex;
    gap: 0.9rem;
    color: var(--smoke);
    font-size: 0.8125rem;
    transition: opacity 0.6s;
  }
  .tally .num { color: var(--ash); font-variant-numeric: tabular-nums; }
  .tally.waiting { opacity: 0; }

  /* Live version: a pinned stage with the scan and one stop visible at a time. */
  :global(html[data-hero='live']) .hero { height: 320vh; }
  :global(html[data-hero='live']) .stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
  }
  :global(html[data-hero='live']) .scene {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  :global(html[data-hero='live']) .fallback,
  :global(html[data-hero='live']) .static-only { display: none; }
  :global(html[data-hero='live']) .live-only { display: inline; }
  :global(html[data-hero='live']) p.live-only { display: block; }
  :global(html[data-hero='live']) p.tally { display: flex; }
  :global(html[data-hero='live']) .copy {
    position: absolute;
    inset: 0;
    margin-inline: auto;
    padding: 0 var(--gutter);
    pointer-events: none;
  }
  :global(html[data-hero='live']) .stop {
    position: absolute;
    left: var(--gutter);
    top: 50%;
    translate: 0 -50%;
    width: min(38rem, 44vw);
    margin: 0;
    will-change: opacity, transform;
  }
  :global(html[data-hero='live']) .stop-0 { top: auto; bottom: 12vh; translate: none; }
  :global(html[data-hero='live']) .stop a { pointer-events: auto; }

  /* No words: a hairline with a point of light running down it. */
  .scroll-hint {
    position: absolute;
    left: 50%;
    bottom: 1.25rem;
    width: 1px;
    height: 44px;
    background: linear-gradient(transparent, var(--graphite) 30%, var(--graphite) 70%, transparent);
    opacity: var(--hint, 1);
  }
  .scroll-hint::after {
    content: '';
    position: absolute;
    left: -1.5px;
    top: 0;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #fff3e6;
    box-shadow: 0 0 6px 1px rgb(255 243 230 / 0.5);
    opacity: 0;
    animation: hint-fall 3.6s cubic-bezier(0.45, 0, 0.55, 1) 1.5s infinite;
  }
  @keyframes hint-fall {
    0% { transform: translateY(0); opacity: 0; }
    15% { opacity: 1; }
    55% { transform: translateY(40px); opacity: 0; }
    100% { transform: translateY(40px); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-hint::after { animation: none; }
  }

  @media (max-width: 760px) {
    :global(html[data-hero='live']) .stop {
      top: auto;
      bottom: 4.5rem;
      translate: none;
      width: auto;
      right: var(--gutter);
    }
    :global(html[data-hero='live']) .stop-0 { bottom: 4.5rem; }
    .tally { left: var(--gutter); right: auto; bottom: 1rem; font-size: 0.75rem; opacity: calc(1 - var(--hint, 1)); }
    .tally-pair { display: none; }
    .stop p { font-size: 1.1875rem; }
    .readout { font-size: 0.875rem; }
  }
</style>
