---
/** Performances of one piece: dated rows with venue, event and measured Bell value. */
import type { CollectionEntry } from 'astro:content';
import BellScale from '../BellScale.astro';
import { formatRange } from '../../lib/format';
import { getLang, localize } from '../../i18n';

/** Pass the shows already localized (localizeAll) on German pages. */
interface Props { shows: CollectionEntry<'shows'>[] }
const { shows } = Astro.props;
const lang = getLang(Astro);
const de = lang === 'de';
const now = new Date();
---
<ol class="performances">
  {shows.map((s) => {
    const upcoming = s.data.date >= now;
    return (
      <li>
        <p class="date ui num">{formatRange(s.data.date, s.data.endDate, lang)}</p>
        <div class="where">
          <a href={localize(lang, `/shows/${s.id}/`)}>{s.data.venue}, {s.data.city}</a>
          <p class="event dim">
            {s.data.title}
            {s.data.premiere && (de ? ', Uraufführung' : ', premiere')}
            {s.data.kind === 'talk' && s.data.format && `. ${s.data.format}`}
            {upcoming && (de ? '. Demnächst' : '. Upcoming')}
          </p>
        </div>
        <div class="bell">
          {s.data.bell !== undefined && <BellScale value={s.data.bell} compact />}
        </div>
      </li>
    );
  })}
</ol>

<style>
  .performances { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--graphite); }
  li {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) minmax(12rem, 16rem);
    gap: 0.5rem var(--gutter);
    padding-block: 1.25rem 1.4rem;
    border-bottom: 1px solid var(--graphite);
    align-items: start;
  }
  .date { margin: 0.2rem 0 0; color: var(--ash); font-size: 0.9375rem; }
  .where a { font-size: 1.125rem; text-decoration: none; }
  .where a:hover { text-decoration: underline; }
  .event { margin: 0.2rem 0 0; font-size: 0.9375rem; }
  .bell :global(.track) { margin-top: 1.25rem; }
  .bell :global(.value) { margin-top: 0.6rem; font-size: 0.875rem; }
  @media (max-width: 760px) {
    li { grid-template-columns: 1fr; }
  }
</style>
