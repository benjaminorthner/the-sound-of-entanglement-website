---
import Wordmark from './Wordmark.astro';

const nav = [
  { href: '/pieces/', label: 'Pieces' },
  { href: '/shows/', label: 'Shows' },
  { href: '/physics/', label: 'Physics' },
  { href: '/people/', label: 'People' },
  { href: '/publications/', label: 'Papers and press' },
  { href: '/booking/', label: 'Booking' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(href);
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="home" href="/"><Wordmark /></a>
    <button class="menu-toggle ui" aria-expanded="false" aria-controls="site-nav" data-menu-toggle>
      Menu
    </button>
    <nav id="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a class="ui" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
    toggle.textContent = open ? 'Close' : 'Menu';
  });
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    transition: background-color 0.3s ease;
  }
  /* Keeps the nav legible over bright full-bleed photos before scrolling. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -32px 0;
    z-index: -1;
    background: linear-gradient(rgb(0 0 0 / 0.7), rgb(0 0 0 / 0));
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .site-header.scrolled::before,
  .site-header.open::before { opacity: 0; }
  .site-header.scrolled,
  .site-header.open {
    background: rgb(0 0 0 / 0.86);
    backdrop-filter: blur(8px);
  }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .home { text-decoration: none; }
  ul {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    color: var(--ash);
    font-size: 0.9375rem;
    padding-block: 0.5rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--paper);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--graphite);
  }
  .menu-toggle {
    display: none;
    background: none;
    border: 1px solid var(--graphite);
    color: var(--paper);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
  }
  @media (max-width: 860px) {
    .menu-toggle { display: block; }
    nav {
      display: none;
      position: fixed;
      inset: var(--header-h) 0 0 0;
      background: var(--black);
      padding: 2rem var(--gutter);
    }
    .open nav { display: block; }
    ul { flex-direction: column; gap: 0.25rem; }
    nav a { font-size: var(--step-2); font-weight: 300; color: var(--paper); display: block; }
  }
</style>
