---
import Wordmark from './Wordmark.astro';
import { getLang, useT, localize, alternates } from '../i18n';

const lang = getLang(Astro);
const t = useT(lang);
const nav = [
  { href: '/pieces/', label: t('nav.pieces') },
  { href: '/shows/', label: t('nav.shows') },
  { href: '/physics/', label: t('nav.physics') },
  { href: '/people/', label: t('nav.people') },
  { href: '/publications/', label: t('nav.publications') },
  { href: '/booking/', label: t('nav.booking') },
].map((i) => ({ ...i, href: localize(lang, i.href) }));
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== '/de/' && path.startsWith(href));
const other = lang === 'de' ? 'en' : 'de';
const otherHref = alternates(path)[other];
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="home" href={localize(lang, '/')}><Wordmark /></a>
    <button class="menu-toggle ui" aria-expanded="false" aria-controls="site-nav" data-menu-toggle data-open={t('nav.menu')} data-close={t('nav.close')}>
      {t('nav.menu')}
    </button>
    <nav id="site-nav" aria-label={t('nav.main')}>
      <ul>
        {nav.map((item) => (
          <li>
            <a class="ui" href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="lang">
          <a class="ui" href={otherHref} hreflang={other} lang={other} aria-label={t('lang.switchLabel')}>{t('lang.switch')}</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = header.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
    document.documentElement.classList.toggle('menu-open', open);
    toggle.textContent = (open ? toggle.dataset.close : toggle.dataset.open) ?? '';
  });
  // Close the menu with Escape, after following a link, or when widening past the breakpoint.
  const close = () => {
    toggle.setAttribute('aria-expanded', 'false');
    header.classList.remove('open');
    document.documentElement.classList.remove('menu-open');
    toggle.textContent = toggle.dataset.open ?? '';
  };
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && header.classList.contains('open')) { close(); toggle.focus(); } });
  header.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', close));
  matchMedia('(min-width: 861px)').addEventListener('change', (m) => m.matches && close());
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--header-h);
    transition: background-color 0.3s ease;
  }
  /* Keeps the nav legible over bright full-bleed photos before scrolling. */
  .site-header::before {
    content: '';
    position: absolute;
    inset: 0 0 -32px 0;
    z-index: -1;
    background: linear-gradient(rgb(0 0 0 / 0.7), rgb(0 0 0 / 0));
    pointer-events: none;
    transition: opacity 0.3s ease;
  }
  .site-header.scrolled::before,
  .site-header.open::before { opacity: 0; }
  /* The frosted bar is a pseudo-element: a backdrop-filter on the header itself
     would make it the containing block of the fixed mobile menu, which would
     then collapse to the header's height and spill over the page. */
  .site-header::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(0 0 0 / 0.86);
    backdrop-filter: blur(8px);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .site-header.scrolled::after,
  .site-header.open::after { opacity: 1; }
  .bar {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }
  .home { text-decoration: none; }
  ul {
    display: flex;
    gap: clamp(1rem, 2.4vw, 2.25rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    text-decoration: none;
    color: var(--ash);
    font-size: 0.9375rem;
    padding-block: 0.5rem;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--paper);
  }
  nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-color: var(--graphite);
  }
  .lang { padding-left: clamp(1rem, 2.4vw, 2.25rem); border-left: 1px solid var(--graphite); }
  .lang a { color: var(--smoke); }
  .lang a:hover { color: var(--paper); }
  .menu-toggle {
    display: none;
    background: none;
    border: 1px solid var(--graphite);
    color: var(--paper);
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    cursor: pointer;
  }
  @media (max-width: 860px) {
    .lang { padding-left: clamp(1rem, 2.4vw, 2.25rem); border-left: 1px solid var(--graphite); }
  .lang a { color: var(--smoke); }
  .lang a:hover { color: var(--paper); }
  .menu-toggle { display: block; }
    nav {
      display: none;
      position: fixed;
      inset: var(--header-h) 0 0 0;
      background: var(--black);
      padding: 2rem var(--gutter);
    }
    .open nav { display: block; overflow-y: auto; z-index: 60; }
    :global(html.menu-open) { overflow: hidden; }
    ul { flex-direction: column; gap: 0.25rem; }
    nav a { font-size: var(--step-2); font-weight: 300; color: var(--paper); display: block; }
    .lang { border-left: 0; padding-left: 0; margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--graphite); }
    .lang a { font-size: var(--step-1); color: var(--ash); }
  }
</style>
