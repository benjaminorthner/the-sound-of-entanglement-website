---
/**
 * Click-to-load YouTube embed (privacy-enhanced domain). Nothing is fetched
 * from YouTube until the visitor presses play. The poster is a local photo.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  id: string;
  title: string;
  poster: ImageMetadata;
  posterAlt?: string;
  /** e.g. "18 min" */
  duration?: string;
}
const { id, title, poster, posterAlt = '', duration } = Astro.props;
---
<div class="yt" data-yt={id} data-title={title}>
  <Image src={poster} alt={posterAlt} widths={[800, 1200, 1600]} sizes="(min-width: 1000px) 60vw, 100vw" format="webp" />
  <button class="play" aria-label={`Play video: ${title}`}>
    <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="31" /><path d="M26 20 L46 32 L26 44 Z" /></svg>
    <span class="ui">{title}{duration && <span class="dim"> ({duration})</span>}</span>
  </button>
</div>
<p class="note ui dim">Plays from YouTube. Nothing loads until you press play.</p>

<script>
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    el.querySelector('button')!.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${el.dataset.yt}?autoplay=1&rel=0`;
      iframe.title = el.dataset.title ?? 'Video';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      el.replaceChildren(iframe);
    });
  });
</script>

<style>
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--soot);
    overflow: hidden;
  }
  .yt :global(img), .yt :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 0;
  }
  .yt :global(img) { filter: brightness(0.6); transition: filter 0.3s; }
  .yt:hover :global(img) { filter: brightness(0.8); }
  .play {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    background: none;
    border: 0;
    color: var(--paper);
    cursor: pointer;
  }
  svg { width: 64px; height: 64px; }
  .play > .ui { padding-inline: 1rem; text-align: center; }
  @media (max-width: 480px) {
    svg { width: 48px; height: 48px; }
    .play > .ui { display: none; } /* the button's aria-label carries the title */
  }
  circle { fill: none; stroke: var(--paper); stroke-width: 1; }
  path { fill: var(--paper); }
  .note { margin-top: 0.5rem; font-size: 0.8125rem; }
</style>
