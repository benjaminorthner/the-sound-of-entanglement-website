---
import { meta } from '../../lib/image';
import { render, type CollectionEntry } from 'astro:content';
import Portrait from './Portrait.astro';
import { getLang } from '../../i18n';
import { localized } from '../../i18n/content';
import { photosDe, photoKey } from '../../i18n/photos.de';

interface Props {
  person: CollectionEntry<'people'>;
}
const { person } = Astro.props;
const lang = getLang(Astro);
const { data: d, entry } = await localized('people', person, lang);
const { Content } = await render(entry);

// Link labels that are not names
const linkDe: Record<string, string> = {
  'JKU profile': 'JKU-Profil',
  'Qudit quantum technology group': 'Forschungsgruppe Qudit-Quantentechnologie',
};
// Portrait alt texts on German pages: shared photo table first, then these
const altDe: Record<string, string> = {
  'benjamin-orthner': 'Benjamin Orthner beim Experiment am Europäischen Forum Alpbach, während er den Aufbau erklärt.',
  'judith-schwarz': 'Porträt von Judith Schwarz am Schlagzeug.',
};
const portraitAlt = (p: NonNullable<typeof d.portrait>) =>
  lang === 'de' ? (photosDe[photoKey(meta(p.src).src)]?.alt ?? altDe[person.id] ?? `Porträt von ${d.name}.`) : p.alt;
const label = (l: string) => (lang === 'de' ? (linkDe[l] ?? l) : l);
---
<article class="person" id={person.id}>
  {d.portrait && <Portrait src={d.portrait.src} alt={portraitAlt(d.portrait)} credit={d.portrait.credit} />}
  <div class="text">
    <h3>{d.website ? <a class="name-link" href={d.website}>{d.name}</a> : d.name}</h3>
    <p class="role">{d.role}</p>
    {d.affiliation && <p class="aff dim">{d.affiliation}</p>}
    <div class="bio"><Content /></div>
    {d.links.length > 0 && (
      <ul class="links ui">
        {d.links.map((l) => <li><a href={l.url}>{label(l.label)}</a></li>)}
      </ul>
    )}
  </div>
</article>

<style>
  .person {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: start;
  }
  .person:not(:has(:global(.portrait))) { grid-template-columns: 1fr; }
  @media (max-width: 560px) {
    .person { grid-template-columns: minmax(0, 1fr); }
    .person :global(.portrait) { max-width: 70%; }
  }
  h3 { font-size: var(--step-2); font-weight: 300; }
  .name-link { text-decoration: none; background-image: linear-gradient(currentColor, currentColor); background-size: 100% 1px; background-position: 0 100%; background-repeat: no-repeat; }
  .name-link:hover { color: var(--ash); }
  .role { margin: 0.6rem 0 0; font-family: var(--font-display); font-size: 1rem; }
  .aff { margin: 0.2rem 0 0; font-family: var(--font-display); font-size: 0.9375rem; }
  .bio { margin-top: 1.1rem; font-size: 1.0625rem; }
  .bio :global(p) { margin-bottom: 0.8em; }
  .links { list-style: none; padding: 0; margin: 0.5rem 0 0; display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
  .links a { color: var(--ash); font-size: 0.875rem; }
  .links a:hover { color: var(--paper); }
</style>
