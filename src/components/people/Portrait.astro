---
import { ladder, QUALITY } from '../../lib/image';
/**
 * A person's portrait with its credit. Portraits come from different
 * photographers and palettes, so they are shown in greyscale for a common
 * tone; colour returns on hover. Handles small source images (e.g. 330 px).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getLang, useT } from '../../i18n';

interface Props {
  src: ImageMetadata;
  alt: string;
  credit: string;
  sizes?: string;
}
const { src, alt, credit, sizes = '(min-width: 900px) 18vw, 70vw' } = Astro.props;
const t = useT(getLang(Astro));
const widths = ladder(src, 1600);
---
<figure class="portrait">
  <div class="frame">
    <Image src={src} alt={alt} widths={widths} sizes={sizes} format="webp" quality={QUALITY} />
  </div>
  <figcaption class="ui">{credit.startsWith('©') ? credit : `${t('photo.credit')}: ${credit}`}</figcaption>
</figure>

<style>
  .portrait { margin: 0; }
  .frame { aspect-ratio: 4 / 5; overflow: hidden; background: var(--soot); }
  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    filter: grayscale(1) contrast(1.05) brightness(0.92);
    transition: filter 0.4s ease;
  }
  .portrait:hover .frame :global(img) { filter: none; }
  figcaption { margin-top: 0.5rem; color: var(--smoke); font-size: 0.75rem; }
  @media (prefers-reduced-motion: reduce) {
    .frame :global(img) { transition: none; }
  }
</style>
