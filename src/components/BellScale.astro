---
/**
 * The Bell value S on a single hairline from 0 to 2√2 (the quantum maximum):
 *
 *                      2           2√2
 *   ───────────────────┼━━━━━━━━○━━━━┤
 *
 * The stretch beyond the classical limit 2 is drawn a little brighter: only
 * entangled photons reach it. The measured value is a ring (in the BruQner
 * visuals, circles meant entanglement). Everything else is left out on
 * purpose; the value line underneath carries the meaning.
 *
 * Props: value, label, compact. Optional: `sigma` (uncertainty band),
 * `marks` (small reference ticks), `live` (ring and band without text, moved
 * by a script via `--x`, `--lo`, `--hi` in percent of 0–2√2, with the
 * `quantum` class toggled on [data-bell-scale]; see physics/BellLab.astro).
 * `range` is accepted for compatibility; the scale always starts at 0.
 */
interface Props {
  value?: number;
  /** Short label after the value, e.g. "measured that night" */
  label?: string;
  compact?: boolean;
  sigma?: number;
  range?: 'zoom' | 'full';
  marks?: { value: number; label: string }[];
  live?: boolean;
}
const { value, label, compact = false, sigma, marks = [], live = false } = Astro.props;

const QMAX = 2 * Math.SQRT2;
const pct = (v: number) => (Math.max(0, Math.min(v, QMAX)) / QMAX) * 100;
const p2 = pct(2);
const quantum = value !== undefined && value > 2;
const described =
  value === undefined
    ? ''
    : `Bell value S = ${value.toFixed(2)}${label ? `, ${label}` : ''}. ` +
      (quantum ? 'Above the classical limit of 2, which only entangled photons can reach. ' : 'At or below the classical limit of 2. ') +
      'The quantum maximum is 2√2, about 2.83.';
---
<div
  class:list={['bell-scale', { compact, quantum }]}
  style={`--p2: ${p2}%;${value !== undefined ? ` --x: ${pct(value)}%;` : ''}${
    sigma !== undefined && value !== undefined ? ` --lo: ${pct(value - sigma)}%; --hi: ${pct(value + sigma)}%;` : ''
  }`}
  data-bell-scale
>
  {value !== undefined && !live && <p class="visually-hidden">{described}</p>}
  <div class="scale" aria-hidden="true">
    <div class="numbers ui num">
      <span class="n two">{!compact && <span class="word">classical limit </span>}2</span>
      <span class="n max">2√2{!compact && <span class="word"> maximum</span>}</span>
    </div>
    <div class="track">
      <span class="beyond"></span>
      <span class="tick at-two"></span>
      <span class="tick at-max"></span>
      {marks.map((m) => <span class="mark" style={`left: ${pct(m.value)}%`} title={`${m.label}: ${m.value.toFixed(2)}`}></span>)}
      {((sigma !== undefined && value !== undefined) || live) && <span class="sigma"></span>}
      {(value !== undefined || live) && <span class="ring"></span>}
    </div>
  </div>
  {value !== undefined && !live && (
    <p class="value num" aria-hidden="true">
      S = {value.toFixed(2)}{label && <span class="label dim"> {label}</span>}
    </p>
  )}
</div>

<style>
  .bell-scale {
    --x: 0%;
    --p2: 70.7%;
    --lo: 0%;
    --hi: 0%;
    container-type: inline-size;
    width: 100%;
  }
  .numbers {
    position: relative;
    height: 1rem;
    font-size: 0.75rem;
    color: var(--ash);
  }
  .n { position: absolute; bottom: 0; line-height: 1; white-space: nowrap; }
  .two { left: var(--p2); transform: translateX(-50%); }
  .max { right: 0; transform: translateX(50%); }
  .bell-scale:not(.compact) .max { transform: none; }

  .track {
    position: relative;
    height: 11px;
    margin-top: 0.4rem;
  }
  /* the whole scale: one hairline */
  .track::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 5px;
    height: 1px;
    background: var(--graphite);
  }
  /* beyond the classical limit: the same line, a little brighter */
  .beyond {
    position: absolute;
    left: var(--p2);
    right: 0;
    top: 5px;
    height: 1px;
    background: rgb(235 231 223 / 0.45);
  }
  .tick {
    position: absolute;
    top: 1px;
    width: 1px;
    height: 9px;
    background: var(--ash);
  }
  .at-two { left: var(--p2); }
  .at-max { right: 0; background: var(--smoke); }
  .mark {
    position: absolute;
    top: 8px;
    width: 1px;
    height: 5px;
    background: var(--smoke);
  }
  .sigma {
    position: absolute;
    left: var(--lo);
    width: calc(var(--hi) - var(--lo));
    top: 4px;
    height: 3px;
    background: rgb(235 231 223 / 0.25);
    transition: left 0.2s ease, width 0.2s ease;
  }
  .ring {
    position: absolute;
    left: var(--x);
    top: 5.5px;
    width: 9px;
    height: 9px;
    margin: -4.5px 0 0 -4.5px;
    border-radius: 50%;
    border: 1px solid var(--paper);
    background: var(--black);
    box-shadow: 0 0 10px rgb(235 231 223 / 0.35);
    transition: left 0.2s ease;
  }
  .bell-scale:not(.quantum) .ring { border-color: var(--ash); box-shadow: none; }
  @media (prefers-reduced-motion: reduce) {
    .ring, .sigma { transition: none; }
  }

  .value { margin: 0.6rem 0 0; font-size: 1rem; line-height: 1.35; }
  .label { font-family: var(--font-display); font-size: 0.8125rem; }

  .bell-scale:not(.compact) .numbers { font-size: 0.8125rem; height: 1.2rem; }
  .bell-scale:not(.compact) .ring { width: 11px; height: 11px; margin: -5.5px 0 0 -5.5px; }
  .bell-scale:not(.compact) .value { font-size: 1.125rem; }

  @container (max-width: 760px) {
    .word { display: none; }
  }
</style>
