---
/**
 * Photo gallery with a lightbox.
 *
 * Photos are grouped by their `caption`: photos without one are the main set,
 * photos sharing a caption form a titled group ("The lecture", "After the
 * performance", ...), in order of first appearance. "From the slides" renders
 * as a horizontal strip.
 *
 * Rhythm of the main set: a full-width lead, then a pair of large images,
 * then three-column masonry, broken every nine photos by another full-width
 * landscape. Small sets are simply lead + two columns.
 *
 * Lightbox: native <dialog>, large optimised versions, caption and credit,
 * arrow keys, Esc, focus kept inside, swipe on touch, focus returns on close.
 */
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Item { src: ImageMetadata; alt: string; credit: string; caption?: string }
interface Props { items: Item[]; label?: string }
const { items, label = 'Photographs' } = Astro.props;

const SLIDES = 'From the slides';
type Block = { kind: 'full' | 'pair' | 'masonry' | 'strip'; items: { it: Item; i: number }[] };
type Group = { title?: string; blocks: Block[] };

const creditLine = (c: string) => (c.startsWith('©') ? c : `Photo: ${c}`);
const landscape = (it: Item) => it.src.width >= it.src.height * 1.2;

// Order: main set first, then named groups in order of first appearance.
const named = [...new Set(items.filter((i) => i.caption).map((i) => i.caption!))];
const ordered = [...items.filter((i) => !i.caption), ...named.flatMap((n) => items.filter((i) => i.caption === n))];
const indexed = ordered.map((it, i) => ({ it, i }));

function rhythm(list: typeof indexed): Block[] {
  const rest = [...list];
  const take = (pred: (x: (typeof indexed)[0]) => boolean) => {
    const k = rest.findIndex(pred);
    return k >= 0 ? rest.splice(k, 1)[0] : rest.shift()!;
  };
  if (rest.length === 0) return [];
  if (rest.length === 1) return [{ kind: 'full', items: rest }];
  if (rest.length === 2) return [{ kind: 'pair', items: rest }];
  const blocks: Block[] = [{ kind: 'full', items: [take((x) => landscape(x.it))] }];
  if (rest.length === 2 || rest.length > 5) blocks.push({ kind: 'pair', items: rest.splice(0, 2) });
  while (rest.length) {
    blocks.push({ kind: 'masonry', items: rest.splice(0, 9) });
    if (rest.length > 3) blocks.push({ kind: 'full', items: [take((x) => landscape(x.it))] });
  }
  return blocks;
}

const groups: Group[] = [];
const main = indexed.filter((x) => !x.it.caption);
if (main.length) groups.push({ blocks: rhythm(main) });
for (const n of named) {
  const list = indexed.filter((x) => x.it.caption === n);
  const kind: Block['kind'] = n === SLIDES ? 'strip' : list.length <= 2 ? 'pair' : 'masonry';
  groups.push({ title: n, blocks: [{ kind, items: list }] });
}
// Main set in a small gallery (<= 6) keeps the two-column look.
const smallGallery = ordered.length <= 6;

const large = await Promise.all(
  ordered.map((it) => getImage({ src: it.src, width: Math.min(2400, it.src.width), format: 'webp', quality: 84 })),
);
const credits = [...new Set(items.map((i) => i.credit))];
const sizesFor = (k: Block['kind']) =>
  k === 'full' ? '100vw' : k === 'pair' ? '(min-width: 860px) 50vw, 100vw' : k === 'strip' ? '420px' : '(min-width: 860px) 33vw, 100vw';
---
<section class:list={['gallery', { small: smallGallery }]} aria-label={label} data-gallery>
  {groups.map((g) => (
    <div class="group">
      {g.title && <h3 class="group-title">{g.title}</h3>}
      {g.blocks.map((b) => (
        <ul class:list={['block', b.kind, { two: b.kind === 'masonry' && b.items.length <= 4 }]}>
          {b.items.map(({ it, i }) => (
            <li class="item">
              <button
                class="open"
                data-large={large[i].src}
                data-alt={it.alt}
                data-group={it.caption ?? ''}
                data-credit={creditLine(it.credit)}
                aria-label={`Open photo ${i + 1} of ${ordered.length}: ${it.alt}`}
              >
                <Image
                  src={it.src}
                  alt={it.alt}
                  widths={[400, 800, 1200, 1600, 2000].filter((w) => w <= it.src.width)}
                  sizes={sizesFor(b.kind)}
                  format="webp"
                  quality={80}
                />
              </button>
            </li>
          ))}
        </ul>
      ))}
    </div>
  ))}
  <p class="credits ui">{credits.map(creditLine).join('; ')}.</p>

  <dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
    <div class="lb-inner">
      <figure class="lb-figure">
        <img class="lb-img" alt="" />
        <figcaption class="lb-caption">
          <span class="lb-group ui"></span>
          <span class="lb-text"></span>
          <span class="lb-credit ui"></span>
        </figcaption>
      </figure>
      <div class="lb-controls">
        <button class="lb-btn ui" data-prev aria-label="Previous photo">Previous</button>
        <span class="lb-count ui num" aria-live="polite"></span>
        <button class="lb-btn ui" data-next aria-label="Next photo">Next</button>
        <button class="lb-btn lb-close ui" data-close>Close</button>
      </div>
    </div>
  </dialog>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button.open'));
    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const img = dialog.querySelector<HTMLImageElement>('.lb-img')!;
    const group = dialog.querySelector<HTMLElement>('.lb-group')!;
    const text = dialog.querySelector<HTMLElement>('.lb-text')!;
    const credit = dialog.querySelector<HTMLElement>('.lb-credit')!;
    const count = dialog.querySelector<HTMLElement>('.lb-count')!;
    const focusables = () => Array.from(dialog.querySelectorAll<HTMLButtonElement>('button'));
    let index = 0;
    let opener: HTMLButtonElement | null = null;

    const show = (i: number) => {
      index = (i + buttons.length) % buttons.length;
      const b = buttons[index];
      img.src = b.dataset.large!;
      img.alt = b.dataset.alt!;
      group.textContent = b.dataset.group ?? '';
      text.textContent = b.dataset.alt!;
      credit.textContent = b.dataset.credit!;
      count.textContent = `${index + 1} of ${buttons.length}`;
      [index + 1, index - 1].forEach((j) => {
        new Image().src = buttons[(j + buttons.length) % buttons.length].dataset.large!;
      });
    };

    buttons.forEach((b, i) =>
      b.addEventListener('click', () => {
        opener = b;
        show(i);
        dialog.showModal();
        dialog.querySelector<HTMLButtonElement>('[data-next]')!.focus();
      }),
    );
    dialog.querySelector('[data-prev]')!.addEventListener('click', () => show(index - 1));
    dialog.querySelector('[data-next]')!.addEventListener('click', () => show(index + 1));
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => opener?.focus());
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog || (e.target as HTMLElement).classList.contains('lb-inner')) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); show(index + 1); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); show(index - 1); }
      else if (e.key === 'Tab') {
        const f = focusables();
        const first = f[0], last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });
    let x0: number | null = null;
    dialog.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dialog.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50) show(index + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  });
</script>

<style>
  .group + .group { margin-top: clamp(3rem, 7vw, 5.5rem); }
  .group-title {
    font-size: var(--step-2);
    margin-bottom: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--graphite);
  }
  .block {
    list-style: none;
    margin: 0 0 var(--gutter);
    padding: 0;
  }
  .item { margin: 0; }
  .full .item :global(img) { max-height: 88vh; object-fit: cover; }
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--gutter); align-items: start; }
  .pair :global(img) { aspect-ratio: 4 / 3; object-fit: cover; }
  .masonry { columns: 3; column-gap: var(--gutter); }
  .small .masonry, .masonry.two { columns: 2; }
  .masonry .item { break-inside: avoid; margin-bottom: var(--gutter); }

  .strip {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 0.75rem;
    scrollbar-color: var(--graphite) transparent;
  }
  .strip .item { flex: 0 0 auto; scroll-snap-align: start; }
  .strip :global(img) { height: clamp(160px, 22vw, 260px); width: auto; }

  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--soot);
    cursor: zoom-in;
  }
  .strip .open { width: auto; }
  .open :global(img) {
    width: 100%;
    height: auto;
    filter: brightness(0.94);
    transition: filter 0.25s ease;
  }
  .strip .open :global(img) { width: auto; }
  .open:hover :global(img) { filter: brightness(1.05); }
  .open:focus-visible { outline-offset: 4px; }
  .credits {
    color: var(--smoke);
    font-size: 0.8125rem;
    line-height: 1.5;
    max-width: none;
    margin-top: 0.25rem;
  }
  @media (max-width: 860px) {
    .masonry, .small .masonry, .masonry.two { columns: 1; }
    .pair { grid-template-columns: 1fr; }
  }

  .lightbox {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgb(0 0 0 / 0.96);
    color: var(--paper);
  }
  .lightbox::backdrop { background: rgb(0 0 0 / 0.85); }
  .lb-inner {
    height: 100%;
    display: grid;
    grid-template-rows: 1fr auto;
    padding: clamp(12px, 3vw, 40px) var(--gutter) 16px;
    gap: 1rem;
  }
  .lb-figure {
    margin: 0;
    min-height: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: 0.75rem;
  }
  .lb-img { width: 100%; height: 100%; object-fit: contain; min-height: 0; }
  .lb-caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    align-items: baseline;
    font-size: 1rem;
    max-width: 80ch;
  }
  .lb-group { color: var(--ash); font-size: 0.8125rem; }
  .lb-group:empty { display: none; }
  .lb-credit { color: var(--ash); font-size: 0.8125rem; }
  .lb-controls {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--graphite);
    padding-top: 0.75rem;
  }
  .lb-btn {
    background: none;
    border: 1px solid var(--graphite);
    color: var(--paper);
    border-radius: 999px;
    padding: 0.45rem 1rem;
    cursor: pointer;
    font-size: 0.875rem;
  }
  .lb-btn:hover { border-color: var(--ash); }
  .lb-count { color: var(--ash); min-width: 5.5rem; text-align: center; }
  .lb-close { margin-left: auto; }
</style>
